<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the .NET SDK on Linux resolve the Windows targeting pack from NuGet. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PipeSizer</AssemblyName>
    <Version>1.1.3</Version>
    <AssemblyVersion>1.1.3.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PipeSizer.Sizing/PipeSizer.Sizing.csproj" />
    <!-- Revit 2025 API reference assemblies (Nice3point). ExcludeAssets="runtime"
         keeps them compile-only: Revit supplies the real DLLs at runtime, so they
         must NOT be copied next to PipeSizer.dll. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.60" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.60" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
